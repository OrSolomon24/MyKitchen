# Supabase project settings > API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>
SUPABASE_ANON_KEY=<anon public key>

# Access tokens are verified locally instead of calling supabase.auth.getUser()
# over the network on every request (see server/lib/verifyJwt.js). Projects on
# the newer asymmetric JWT Signing Keys verify via Supabase's public JWKS
# endpoint automatically -- no secret needed. This var is only required as a
# fallback if a token still shows up signed with the legacy HS256 shared
# secret (Project Settings > API > JWT Settings > "Legacy JWT secret").
SUPABASE_JWT_SECRET=<legacy jwt secret from Supabase dashboard, if still shown>

# URL of the Python recipe-extraction agent service (see /agent)
RECIPE_AGENT_URL=http://localhost:8000
